# Copy this file to .env and fill in your values.

# PostgreSQL connection string (Neon format). Falls back to SQLite if not set.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret key for signing JWTs – use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Token expiry in minutes
ACCESS_TOKEN_MINUTES=60

# Credentials for the first super admin (created automatically on startup)
FIRST_SUPERADMIN_EMAIL=superadmin@example.com
FIRST_SUPERADMIN_PASSWORD=SuperSecurePass123

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
